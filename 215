#include <vector>
#include <cstdlib>

class Solution {
public:
    int findKthLargest(std::vector<int>& nums, int k) {
        return quickSelect(nums, 0, nums.size() - 1, k - 1);
    }
    
private:
    int quickSelect(std::vector<int>& nums, int left, int right, int targetIndex) {
        if (left >= right) return nums[left];
        
  
        int pivotIndex = left + rand() % (right - left + 1);
        int pivot = nums[pivotIndex];
        
      
        int l = left;
        int r = right; 
        int i = left;  
        
       
        while (i <= r) {
            if (nums[i] > pivot) {
                std::swap(nums[i], nums[l]);
                l++;
                i++;
            } else if (nums[i] < pivot) {
                std::swap(nums[i], nums[r]);
                r--;
               
            } else {
                i++; 
            }
        }
        
      
        if (targetIndex >= l && targetIndex <= r) {
          
            return pivot;
        } else if (targetIndex < l) {
            
            return quickSelect(nums, left, l - 1, targetIndex);
        } else {
            
            return quickSelect(nums, r + 1, right, targetIndex);
        }
    }
};
