#include <vector>

using namespace std;

class Solution {
public:
    vector<int> getAverages(vector<int>& nums, int k) {
        int n = nums.size();
        vector<int> avgs(n, -1);
        long long window_size =(long long)2 * k + 1;
       
        
        if (n < window_size) return avgs;

       
        vector<long long> pref(n + 1, 0);
        for (int i = 0; i < n; ++i) {
            pref[i + 1] = pref[i] + nums[i];
        }
    
        
        for (int i = k; i <= n - k - 1; ++i) {
           
            long long sum = pref[i + k + 1] - pref[i - k];
            avgs[i] = sum / window_size;
        }

        return avgs;
    }
};
